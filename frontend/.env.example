# Copy to .env.local and fill in to run against a real Firebase project and
# the Spoonacular API. Leave everything empty to run in demo mode.
# Note: REACT_APP_* values are baked into the client bundle and are public.
REACT_APP_DEMO_MODE=false
REACT_APP_SPOONACULAR_KEY=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
